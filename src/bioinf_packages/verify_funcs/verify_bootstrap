def verify_bootstrap(entry: str, n: int, output: str, repeat: int):
    seq = entry.seq
    #print(type(seq))
    species,gene,orien,identity = entry.description.split("|")
    useless,accession = identity.split(":")
    #print(species)
    #print(gene)
    #print(accession)
    matches = 0
    match_score = []
    starts = []

    for i in range(repeat):
        print(f"Collecting Blast Data For: {accession}")
        verify_dic = verify_seq(seq,n)
        print(f"Collected Blast Data For {accession}")
        hit_ids = verify_dic[0]["Accessions"]
        hit_des = verify_dic[0]["Hit_Des"]
        #return start position for snippet
        starts.append(verify_dic[1])
        #loop through hit ids 
        for id in hit_ids:
            if accession in id:
                matches = matches +1
        #loop through descriptions (species and gene)
        for des in hit_des:
            matches = matches + species_parser(species, des) + gene_parser(gene, des)
        match_score.append(matches)
        print(f"Calculated Match Score for {accession} ({matches})")
        matches = 0


    print("Finished!")

    #convert list to frequency dist
    frequency = {}
    for item in match_score:
        if item in frequency:
            frequency[item] += 1
        else: 
            frequency[item] = 1

    #generate filename for plot
    plot_name = f"{output}{"/"}{accession}{"_hist"}"
    #generate plot
    print(frequency)
    plt.bar(frequency.keys(), frequency.values())
    plt.xlim(left=0)
    plt.xlim(right=13)
    plt.xlabel("Hits")
    plt.ylabel("Frequency")
    plt.savefig(plot_name)
    plt.close()

    return(accession, match_score, starts)

